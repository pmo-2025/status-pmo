# Markdown
*.md linguist-detectable=true
*.md linguist-documentation=false

# JSON
*.json linguist-detectable=true

# YAML
*.yml linguist-detectable=true

# El log de incidencias es un histórico que escriben varios runs a la vez:
# si dos versiones divergen, se quedan las líneas de ambas en vez de dar conflicto.
monitor/incidencias.log merge=union
